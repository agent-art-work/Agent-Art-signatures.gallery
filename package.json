{
  "name": "signatures-gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "renderer:verify": "node --import tsx scripts/verify-renderer-lock.mjs",
    "prebuild": "npm run renderer:verify",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run renderer:verify",
    "dev": "node --env-file-if-exists=.env.local --import tsx src/main.ts",
    "predev:fixture": "npm run renderer:verify && npm run open:contract:build",
    "dev:fixture": "node --env-file-if-exists=.env.local --import tsx src/main.ts --fixture --local-chain",
    "predev:open": "npm run renderer:verify && npm run open:contract:build",
    "dev:open": "node --env-file-if-exists=.env.local --import tsx src/main.ts --local-chain",
    "open:contract:build": "cd contracts && forge build --offline",
    "test:open": "vitest run src/openMint",
    "test:open:persistence": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence",
    "test:open:manifest": "node --test contracts/tools/open-signatures-manifest.node-test.mjs",
    "test:onchain:manifest": "node --test contracts/tools/onchain-signatures-manifest.node-test.mjs",
    "onchain:rehearsal": "node --import tsx scripts/onchain-artwork-rehearsal.mjs",
    "generative:rehearsal": "node --import tsx scripts/generative-renderer-rehearsal.mjs",
    "generative:release:check": "node scripts/verify-generative-release.mjs",
    "generative:staging:package": "node --import tsx scripts/build-staging-release.mjs",
    "test:generative:staging:package": "node --import tsx --test contracts/tools/generative-staging-bootstrap.node-test.mjs",
    "test:generative:staging:installed": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --test contracts/tools/generative-staging-installed.node-test.mjs",
    "test:generative:release": "node --test contracts/tools/generative-release.node-test.mjs",
    "pulse:verify": "node contracts/tools/verify-pulse-core-lock.mjs",
    "pulse:allowlist": "node contracts/tools/pulse-allowlist.mjs",
    "test:pulse:c2": "npm run pulse:verify && node --test contracts/tools/pulse-allowlist.node-test.mjs && vitest run src/openMint/pulseCandidate.test.ts && cd contracts && forge test --offline --match-contract PulseAllowlistVectorsTest",
    "test:pulse:c3": "npm run pulse:verify && (cd contracts && forge test --offline --match-path test/SignaturesPulseMintV1RC1.t.sol) && node --import tsx --test contracts/tools/pulse-mint-candidate.node-test.mjs",
    "test:pulse:c4": "npm run test:pulse:c3 && node --test contracts/tools/pulse-c4-model.node-test.mjs && (cd contracts && forge test --offline --match-path test/SignaturesPulseMintC4.t.sol)",
    "pulse:candidate:verify": "node --import tsx contracts/tools/pulse-candidate-lock.mjs",
    "test:pulse:c5": "npm run test:pulse:c4 && (cd contracts && forge test --offline --match-path test/SignaturesPulseMintC5.t.sol) && node --import tsx --test contracts/tools/pulse-candidate-lock.node-test.mjs && vitest run src/openMint/pulseCandidate.test.ts",
    "test:pulse:c5:evm": "node --import tsx --test contracts/tools/pulse-contract-review.node-test.mjs",
    "test:pulse:c6": "npm run typecheck && npm run pulse:candidate:verify && node --import tsx --test contracts/tools/pulse-integration.node-test.mjs && vitest run src/openMint/pulseAuthorization.test.ts src/openMint/projection/pulseDecode.test.ts src/openMint/clientScript.test.ts src/openMint/pages.test.ts",
    "test:pulse:c6:postgres": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/pulsePipeline.postgres.test.ts --maxWorkers=1 --minWorkers=1",
    "pulse:c7:rehearsal": "node --import tsx scripts/pulse-c7-rehearsal.mjs",
    "test:pulse:sepolia": "node --import tsx --test contracts/tools/pulse-sepolia-*.node-test.mjs",
    "test:pulse:sepolia:recovery:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=scripts/pulse-sepolia-attempt-recovery.mjs --test-coverage-include=scripts/pulse-sepolia-site.mjs --test-coverage-lines=88 --test-coverage-branches=85 --test-coverage-functions=90 --test contracts/tools/pulse-sepolia-attempt-recovery.node-test.mjs contracts/tools/pulse-sepolia-reads.node-test.mjs contracts/tools/pulse-sepolia-availability.node-test.mjs contracts/tools/pulse-sepolia-site.node-test.mjs contracts/tools/pulse-sepolia-admin-site.node-test.mjs",
    "test:pulse:sepolia:relay:postgres": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --test contracts/tools/pulse-sepolia-relay-store.node-test.mjs",
    "pulse:sepolia": "node --import tsx scripts/pulse-sepolia.mjs",
    "pulse:sepolia:admin": "node --import tsx scripts/pulse-sepolia-admin.mjs",
    "pulse:sepolia:admin:dev": "node --import tsx scripts/pulse-sepolia-admin-site.mjs",
    "pulse:admin:candidate:verify": "node --import tsx contracts/tools/pulse-admin-candidate.mjs",
    "pulse:sepolia:dev": "node --import tsx scripts/pulse-sepolia-site.mjs",
    "pulse:sepolia:relay:dev": "node --import tsx scripts/pulse-sepolia-relay-local.mjs",
    "pulse:sepolia:relay:migrate": "node scripts/pulse-sepolia-relay-migrate.mjs",
    "pulse:sepolia:safety:review": "node --import tsx scripts/pulse-sepolia-safety-review.mjs",
    "pulse:sepolia:fe": "node --import tsx scripts/pulse-sepolia-fe.mjs",
    "test:generative:deployment": "node --test contracts/tools/generative-deployment.node-test.mjs",
    "test:generative:deployment:coverage": "node --experimental-test-coverage --test-coverage-include=contracts/tools/generative-deployment.mjs --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100 --test contracts/tools/generative-deployment.node-test.mjs",
    "generative:deployment:rehearsal": "node scripts/generative-deployment-rehearsal.mjs",
    "generative:read-limits": "node --import tsx scripts/generative-renderer-rehearsal.mjs --release-candidate --quick --mint --read-limits",
    "generative:numerical-review": "node --import tsx scripts/generative-numerical-review.mjs",
    "test:generative:numerics": "node --import tsx --test contracts/tools/generative-numerics.node-test.mjs",
    "generative:operating-plan": "node --import tsx scripts/generative-operating-plan.mjs",
    "test:generative:operating-plan": "node --import tsx --test contracts/tools/generative-operating-plan.node-test.mjs",
    "test:generative:active-state": "node --import tsx --test contracts/tools/generative-active-state.node-test.mjs",
    "test:generative:active-state:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=contracts/tools/generative-active-state.mjs --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100 --test contracts/tools/generative-active-state.node-test.mjs",
    "generative:active-state:rehearsal": "node --import tsx scripts/generative-active-state-rehearsal.mjs",
    "test:generative:admission": "node --import tsx --test contracts/tools/generative-admission.node-test.mjs",
    "test:generative:admission:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=contracts/tools/generative-admission.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test contracts/tools/generative-admission.node-test.mjs",
    "test:generative:assessment-admission": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/assessmentAdmission.postgres.test.ts --coverage --coverage.include=src/openMint/persistence/assessmentAdmission.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/assessment-admission-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:mint-admission": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/mintAdmission.postgres.test.ts --coverage --coverage.include=src/openMint/persistence/mintAdmission.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/mint-admission-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:reuse-admission": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/reuseAdmission.postgres.test.ts --coverage --coverage.include=src/openMint/persistence/reuseAdmission.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/reuse-admission-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:local-review": "vitest run src/openMint/staging/localReview.test.ts --coverage --coverage.include=src/openMint/staging/localReview.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/local-review-coverage",
    "test:generative:local-runtime": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/localAdmissionRuntime.postgres.test.ts --coverage --coverage.include=src/openMint/persistence/localAdmissionRuntime.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/guarded-runtime-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:review-files": "vitest run src/openMint/staging/localReviewFile.test.ts src/openMint/staging/localReviewFileRace.test.ts --coverage --coverage.include=src/openMint/staging/localReviewFile.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=98 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/review-file-coverage",
    "test:generative:review-startup": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/localAdmissionRuntime.postgres.test.ts --coverage --coverage.include=src/openMint/persistence/localAdmissionStartup.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/review-startup-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:database-certification": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/databaseCertification.test.ts src/openMint/persistence/databaseCertification.postgres.test.ts src/openMint/persistence/stagingRecovery.postgres.test.ts --coverage --coverage.include=src/openMint/persistence/databaseCertification.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=98 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/database-certification-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:readiness-http": "OPEN_MINT_TEST_HTTP=1 vitest run src/openMint/staging/readinessReview.test.ts src/openMint/staging/readinessServer.test.ts --coverage --coverage.include=src/openMint/staging/readinessReview.ts --coverage.include=src/openMint/staging/readinessServer.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=95 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/readiness-http-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:staging-readiness": "OPEN_MINT_TEST_POSTGRES=1 OPEN_MINT_TEST_HTTP=1 node --import tsx --experimental-test-coverage --test-coverage-include=contracts/tools/generative-staging-readiness.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test contracts/tools/generative-staging-readiness.node-test.mjs",
    "test:generative:staging-review": "vitest run src/openMint/staging/stagingReview.test.ts src/openMint/staging/stagingEligibility.test.ts src/openMint/persistence/databaseProfiles.test.ts --coverage --coverage.include=src/openMint/staging/stagingReview.ts --coverage.include=src/openMint/persistence/databaseProfiles.ts --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100 --coverage.reportsDirectory=.local/generative-renderer/staging-review-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:staging-assessment": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --experimental-test-coverage --test-coverage-include=contracts/tools/generative-staging-assessment.mjs --test-coverage-include=contracts/tools/generative-staging-worker.mjs --test-coverage-include=src/openMint/persistence/stagingAssessmentAdmission.ts --test-coverage-lines=100 --test-coverage-branches=98 --test-coverage-functions=100 --test contracts/tools/generative-staging-assessment.node-test.mjs contracts/tools/generative-staging-worker.node-test.mjs",
    "test:generative:staging-mint": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --experimental-test-coverage --test-coverage-include=contracts/tools/generative-staging-mint.mjs --test-coverage-include=src/openMint/persistence/stagingMintAdmission.ts --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=95 --test contracts/tools/generative-staging-mint.node-test.mjs",
    "test:generative:staging-runtime": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --experimental-test-coverage --test-coverage-include=contracts/tools/generative-staging-runtime.mjs --test-coverage-include=contracts/tools/generative-staging-http.mjs --test-coverage-lines=100 --test-coverage-branches=94 --test-coverage-functions=95 --test --test-concurrency=1 contracts/tools/generative-staging-runtime.node-test.mjs contracts/tools/generative-staging-site.node-test.mjs contracts/tools/generative-staging-installed.node-test.mjs",
    "test:generative:staging-restore": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --test contracts/tools/generative-staging-restore.node-test.mjs",
    "test:generative:staging-recovery-unit": "vitest run src/openMint/staging/recoveryReview.test.ts src/openMint/stagingRecoveryChain.test.ts --maxWorkers=1 --minWorkers=1",
    "test:generative:staging-recovery-pg": "OPEN_MINT_TEST_POSTGRES=1 vitest run src/openMint/persistence/stagingRecovery.postgres.test.ts --maxWorkers=1 --minWorkers=1",
    "test:generative:staging-recovery-flow": "OPEN_MINT_TEST_POSTGRES=1 node --import tsx --test contracts/tools/generative-staging-recovery.node-test.mjs contracts/tools/generative-staging-migration.node-test.mjs",
    "generative:staging-browser": "node --import tsx scripts/generative-staging-browser-rehearsal.mjs",
    "test:generative:staging-sharing": "vitest run src/openMint/generativeSharing.test.ts src/openMint/projection/generative.test.ts src/openMint/projection/generativeProvenance.test.ts src/openMint/projection/staging.test.ts --coverage --coverage.include=src/openMint/generativeSharing.ts --coverage.include=src/openMint/projection/generativeArtwork.ts --coverage.include=src/openMint/projection/generativeProvenance.ts --coverage.thresholds.perFile=true --coverage.thresholds.statements=100 --coverage.thresholds.lines=100 --coverage.thresholds.functions=100 --coverage.thresholds.branches=95 --coverage.reportsDirectory=.local/generative-renderer/staging-sharing-coverage --maxWorkers=1 --minWorkers=1",
    "test:generative:staging-transport": "OPEN_MINT_TEST_HTTP=1 vitest run src/openMint/staging/mintTransport.test.ts src/openMint/persistence/sessions.test.ts --coverage --coverage.include=src/openMint/staging/mintTransport.ts --coverage.include=src/openMint/persistence/sessions.ts --coverage.thresholds.perFile=true --coverage.thresholds.statements=100 --coverage.thresholds.lines=100 --coverage.thresholds.functions=100 --coverage.thresholds.branches=95 --coverage.reportsDirectory=.local/generative-renderer/staging-transport-coverage --maxWorkers=1 --minWorkers=1",
    "open:rehearsal": "node scripts/open-mint-rehearsal.mjs",
    "open:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/open-mint-preflight.mjs",
    "legacy:dev": "tsx src/legacyMain.ts",
    "design:fonts": "node --import tsx scripts/font-study.mjs",
    "design:slogan": "node --import tsx scripts/signing-slogan-study.mjs",
    "start": "node dist/main.js",
    "pretest": "npm run renderer:verify",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:v2": "vitest run src/v2 src/api/server.test.ts",
    "test:contract": "cd contracts && forge test --offline",
    "test:manifest": "node contracts/tools/validate-deployment-manifest.mjs --allow-example contracts/deployments/example.anvil.json",
    "test:manifest:roles": "node --test contracts/tools/validate-deployment-manifest.node-test.mjs",
    "local:up": "node --import tsx src/local/rehearsalCli.ts up",
    "local:reset": "node --import tsx src/local/rehearsalCli.ts reset",
    "local:stop": "node --import tsx src/local/rehearsalCli.ts stop",
    "local:status": "node --import tsx src/local/rehearsalCli.ts status",
    "local:verify": "node --import tsx src/local/rehearsalCli.ts verify",
    "local:test": "node --import tsx src/local/interactiveRehearsalTest.ts",
    "prelocal:serve": "npm run renderer:verify",
    "local:serve": "node --env-file-if-exists=.env.local --import tsx src/local/rehearsalServer.ts",
    "local:serve:x": "npm run local:serve -- --x-auth=real",
    "local:serve:emulator": "npm run local:serve -- --x-auth=emulator",
    "local:auth:check": "node --env-file-if-exists=.env.local --import tsx src/local/xAuthCheck.ts",
    "test:postgres:local": "node --import tsx src/local/postgresMigrationTest.ts",
    "slogan:inspect": "node --import tsx src/brand/inspectSloganShapeCandidate.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "0.21.5",
    "solc": "^0.8.30",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/playpen-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/balsamiq-sans": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@openzeppelin/contracts": "^5.6.1",
    "blockstore-core": "^7.0.1",
    "canonicalize": "^4.0.0",
    "ipfs-unixfs-importer": "^17.1.0",
    "multiformats": "^14.0.5",
    "pg": "^8.23.0",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "viem": "^2.56.3"
  }
}
